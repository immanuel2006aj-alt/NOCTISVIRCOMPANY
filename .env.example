# ================================================
# NOCTIS TECHNOLOGIES — Environment Variables
# Copy this file to `.env.local` and fill in real
# values. NEVER commit `.env.local` to git.
# ================================================

# Public site URL (used for metadata and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------
# Supabase (add later — leave blank for now)
# ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------
# Contact form email (Resend — add later)
# ------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ------------------------------------------------
# Avatar provider (optional override)
# ------------------------------------------------
NEXT_PUBLIC_DICEBEAR_BASE_URL=https://api.dicebear.com/9.x/notionists-neutral/svg
